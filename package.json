{
  "name": "imagen-lote",
  "private": true,
  "version": "1.2.0",
  "description": "Conversor local de imágenes por lotes para Windows",
  "author": "Forma",
  "repository": {
    "type": "git",
    "url": "https://github.com/deimisq/forma-conversor-imagenes.git"
  },
  "type": "module",
  "scripts": {
    "test": "node scripts/check-regressions.mjs",
    "test:desktop": "node scripts/run-desktop-tests.mjs es",
    "test:desktop:en": "node scripts/run-desktop-tests.mjs en",
    "dev:en": "node scripts/english.mjs dev",
    "build:app:en": "node scripts/english.mjs build:app",
    "build:en": "npm run build:app:en && electron-builder --config electron-builder.en.cjs --win --publish never",
    "predev": "node scripts/create-icons.mjs",
    "dev": "vite",
    "prebuild": "node scripts/create-icons.mjs",
    "build": "vue-tsc --noEmit && vite build && electron-builder --win --publish never",
    "release": "npm run build:app && npm run test:desktop && electron-builder --win --publish always",
    "release:en": "npm run build:app:en && npm run test:desktop:en && electron-builder --config electron-builder.en.cjs --win --publish always",
    "release:all": "npm run release && npm run release:en",
    "build:all": "npm run build && npm run build:en",
    "prebuild:app": "node scripts/create-icons.mjs",
    "build:app": "vue-tsc --noEmit && vite build",
    "upload:r2:dry-run": "node scripts/upload-release-to-r2.mjs --dry-run",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@lucide/vue": "^1.52.0",
    "electron-updater": "^6.8.9",
    "sharp": "^0.35.5",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2",
    "typescript": "^5.2.2",
    "vite": "^8.3.2",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vue-tsc": "^2.0.26"
  },
  "main": "dist-electron/main.js"
}
