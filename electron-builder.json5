{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.forma.imageconverter",
  "asar": true,
  "productName": "Forma Conversor de Imágenes",
  "publish": [
    {
      "provider": "github",
      "owner": "deimisq",
      "repo": "forma-conversor-imagenes",
      "releaseType": "release"
    }
  ],
  "directories": {
    "output": "release/${version}"
  },
  "files": [
    "dist",
    "dist-electron"
  ],
  "win": {
    "executableName": "Forma",
    "icon": "assets/forma-logo.ico",
    "signExecutable": false,
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "appx",
        "arch": ["x64"]
      }
    ],
    "artifactName": "forma-setup-${version}.${ext}"
  },
  "appx": {
    "applicationId": "FormaConversorDeImagenes",
    "identityName": "DeimisQuintanilla.Forma.ConversordeImgenez",
    "publisher": "CN=5EE69F12-D1D5-44E6-810D-F3E75E2B3C3F",
    "publisherDisplayName": "Deimis Quintanilla",
    "displayName": "Forma Conversor de Imágenes",
    "languages": ["es-ES"]
  },
  "nsis": {
    "installerIcon": "assets/forma-logo.ico",
    "uninstallerIcon": "assets/forma-logo.ico",
    "installerHeaderIcon": "assets/forma-logo.ico",
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false
  },
  "linux": {
    "target": [
      "AppImage"
    ],
    "artifactName": "${productName}-Linux-${version}.${ext}"
  }
}
